{
  "name": "Daybook",
  "short_name": "Daybook",
  "description": "Daily routine, to-dos, internship work tasks and daily reflections.",
  "id": "./",
  "start_url": "./#today",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f4f6f2",
  "theme_color": "#465c47",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Work tasks", "url": "./#work", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Overview", "url": "./#insights", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Journal", "url": "./#journal", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ]
}
